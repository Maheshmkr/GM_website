# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=db_name

# Authentication & Session Security (32+ character random secret)
SESSION_SECRET=generate_a_random_32_character_secret_here

# Admin & User Authentication
ADMIN_PASSWORD=change_this_to_a_strong_admin_password
USER_PASSWORD=change_this_to_a_romantic_visitor_password

# Optional: Pre-hashed Admin Password (scrypt)
# ADMIN_PASSWORD_HASH=

# Production Domain / CORS
ALLOWED_ORIGIN=https://gm-website-mk.vercel.app
